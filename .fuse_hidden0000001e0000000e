</section>

<!-- ===== 4. STUDIO SIDE — split ===== -->
<section class="section">
  <div class="wrap split split--center split--rev">
    <div class="split__stack reveal">
      <div class="split__media">
        <img src="assets/img/about-1.jpg" alt="Barista pulling a shot on an espresso machine during a Klasse Productions location shoot" loading="lazy" decoding="async">
      </div>
      <div class="split__media">
        <img src="assets/img/about-2.jpg" alt="Behind the scenes of a Klasse Productions studio session" loading="lazy" decoding="async">
